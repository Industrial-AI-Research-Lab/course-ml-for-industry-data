# Copy this file to .env and fill in the values. Never commit .env.

# Local model via Ollama (practice 1). No key is needed.
# LOCAL_LLM_MODEL=qwen3.5:4b-q4_K_M
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# Smaller model for a weak laptop (profile local-small).
# LOCAL_SMALL_LLM_MODEL=qwen3.5:2b-q4_K_M

# Course model Qwen 3.8 27B. The URL and the token are in the course channel.
COURSE_LLM_BASE_URL=
COURSE_LLM_API_KEY=
# Model name, only if it differs from iairlab/qwen3.8-27b
# COURSE_LLM_MODEL=

