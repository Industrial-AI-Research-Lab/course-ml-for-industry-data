# Copy this file to .env and fill in the values. Never commit .env.

# Course model Qwen 3.8 27B (multimodal). You get the URL and the token from the lecturers.
COURSE_LLM_BASE_URL=
COURSE_LLM_API_KEY=

# Local VLM via Ollama. No key is needed. Any Ollama model with "vision" works.
# LOCAL_LLM_MODEL=qwen3.5:4b-q4_K_M
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Lecturer only: key with access to frontier models (used to build replay files).
# LECTURER_LLM_API_KEY=
