# Copy this file to .env and fill in the values. Never commit .env.

# Course model Qwen 3.8 27B. You get the URL and the token from the lecturers.
COURSE_LLM_BASE_URL=
COURSE_LLM_API_KEY=

# Local models via Ollama. No key is needed.
# LOCAL_LLM_MODEL=qwen3.5:4b-q4_K_M
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Optional: embeddings and the cross-encoder on the course server (rows M1, M2, M4). The notebook uses saved
# vectors and reranker scores; set these only to rebuild them live.
# COURSE_EMBED_MODEL=iairlab/e5-mistral-7b-instruct
# COURSE_RERANK_MODEL=iairlab/bge-reranker-v2-m3
