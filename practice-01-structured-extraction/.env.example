# Copy this file to .env and fill in the values. Never commit .env.

# Local model via Ollama (practice 1). No key is needed.
# LOCAL_LLM_MODEL=qwen3.5:4b-q4_K_M
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# Weak laptop: the local-small profile uses this model (any Ollama model name works).
# LOCAL_SMALL_LLM_MODEL=qwen3.5:2b-q4_K_M

# Course model Qwen 3.8 27B (from practice 2). You get the URL and the token from the lecturers.
COURSE_LLM_BASE_URL=
COURSE_LLM_API_KEY=

# Lecturer only: key with access to frontier models (used to build replay files).
# LECTURER_LLM_API_KEY=
